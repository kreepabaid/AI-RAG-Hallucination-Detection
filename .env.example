# Hugging Face User Access Token (read permission)
# Get a free token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Default LLM generation model (optional, defaults to meta-llama/Llama-3.1-8B-Instruct)
# Alternatives: Qwen/Qwen2.5-7B-Instruct, mistralai/Mistral-7B-Instruct-v0.3
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
